# MagnoliaDroid Kernel Tuning Config Fragment (Linux 6.6 LTS)
# Based on XanMod & BoRE responsiveness optimizations

# Preemption Model: Full Preemptive Kernel for ultra-low audio & input latency
CONFIG_PREEMPT_BUILD=y
CONFIG_PREEMPT=y
CONFIG_PREEMPT_COUNT=y
# CONFIG_PREEMPT_VOLUNTARY is not set
# CONFIG_PREEMPT_NONE is not set

# Timer Frequency: 1000 Hz for snappy UI response
# CONFIG_HZ_250 is not set
# CONFIG_HZ_300 is not set
CONFIG_HZ_1000=y
CONFIG_HZ=1000

# High Resolution Timer Support
CONFIG_HIGH_RES_TIMERS=y

# CPU Scheduler Tuning
CONFIG_SCHED_BORE=y

# TCP Congestion Control: BBRv3 / BBR
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"

# Futex & Performance optimizations
CONFIG_FUTEX=y
CONFIG_FUTEX_PI=y

# Android Binder & Memfd required configs
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_MEMFD_CREATE=y
CONFIG_PSI=y
CONFIG_PSI_DEFAULT_DISABLED=n
